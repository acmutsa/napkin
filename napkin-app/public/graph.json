{
  "title": "Napkin IntentGraph schema",
  "description": "Reference shape of an IntentGraph as sent by the canvas to /api/compile and /api/analyze. The backend Normalize() step backfills any omitted defaults and ports from the kind registry (napkin-backend/graph/kinds.go). Edges MUST specify both source and target ports; both ports must reference declared ports on their kinds and have matching PortType.",
  "version": "3",
  "portTypes": ["network", "data", "env", "iam"],
  "kinds": [
    "vpc",
    "subnet",
    "securityGroup",
    "iamRole",
    "compute",
    "database",
    "loadBalancer",
    "lambda",
    "sqsQueue",
    "storageBucket"
  ],
  "example": {
    "region": "us-east-1",
    "nodes": {
      "resource": [
        {
          "id": "ec2-01",
          "kind": "compute",
          "spec": {
            "label": "EC2 Instance",
            "class": "resource",
            "type": "aws_instance"
          },
          "ports": {
            "inputs": [
              { "id": "subnet", "type": "network", "label": "Subnet" },
              { "id": "securityGroup", "type": "network", "label": "Security Group" },
              { "id": "inboundTraffic", "type": "network", "label": "Inbound Traffic" },
              { "id": "instanceRole", "type": "iam", "label": "Instance Role" },
              { "id": "dataSource", "type": "data", "label": "Data Source" }
            ],
            "outputs": [
              { "id": "outboundTraffic", "type": "network", "label": "Outbound Traffic" }
            ]
          },
          "attributes": {
            "instance_type": "t2.micro"
          }
        },
        {
          "id": "db-01",
          "kind": "database",
          "spec": {
            "label": "Database",
            "class": "resource",
            "type": "aws_db_instance"
          },
          "ports": {
            "inputs": [
              { "id": "subnet", "type": "network", "label": "Subnet" },
              { "id": "inboundTraffic", "type": "network", "label": "Inbound Traffic" }
            ],
            "outputs": [
              { "id": "connection", "type": "data", "label": "DB Connection" }
            ]
          },
          "attributes": {
            "engine": "mysql",
            "instance_class": "db.t3.micro",
            "username": "admin"
          }
        }
      ]
    },
    "edges": [
      {
        "source": { "node": "resource", "id": "ec2-01", "port": "dataSource" },
        "target": { "node": "resource", "id": "db-01", "port": "connection" },
        "type": "data-flow"
      }
    ]
  }
}
